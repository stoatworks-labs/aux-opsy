{
  // Deployed as a Worker serving static assets — which is what Cloudflare's
  // "Import a repository" flow creates, and what every other hosted app in this
  // fleet uses. A classic Pages project would ignore this file and just publish
  // `dist`; note that `pages_build_output_dir` in a Worker repo fails with a
  // misleading "could not detect a directory containing static files".
  //
  // Deploy:  cf-run npm run deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aux-opsy",
  "compatibility_date": "2026-07-30",

  // Custom domains, created straight from here — DNS records and certificates
  // appear within seconds, no dashboard needed. www serves the same content
  // rather than redirecting; the canonical tags all point at the apex, so search
  // engines still treat the apex as the single address.
  "routes": [
    { "pattern": "aux-opsy.com", "custom_domain": true },
    { "pattern": "www.aux-opsy.com", "custom_domain": true }
  ],

  // MUST stay explicitly true. wrangler silently flips this to false as soon as
  // `routes` exists, which takes the workers.dev URL offline and 404s every
  // published link to it from that deploy on.
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    // The site has a real 404 page; route unmatched paths to it rather than to a
    // bare Cloudflare error.
    "not_found_handling": "404-page"
  }
}
