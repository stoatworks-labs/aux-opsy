---
import Base from '../../layouts/Base.astro';
import data from '../../data/platforms.json';
import { strandOf } from '../../lib/corpus';

export function getStaticPaths() {
  return data.platforms.map((p) => ({ params: { slug: p.id }, props: { platform: p } }));
}

const { platform: p } = Astro.props;
const { statuses, confidence } = data;
const statusMeta = statuses.find((s) => s.id === p.status);

// A candidate entry has no findings to render, so most sections collapse away.
const hasFindings = p.hardware.length > 0 || p.software.length > 0;

// `openProjects` is optional — most platforms have no third-party open project
// on them, and the section collapses away entirely when the array is absent.
const openProjects = p.openProjects ?? [];

const sections = [
  ['summary', 'Summary'],
  hasFindings && ['method', 'Method'],
  p.hardware.length > 0 && ['hardware', 'Hardware'],
  p.software.length > 0 && ['software', 'Software'],
  p.security.length > 0 && ['security', 'Update & security'],
  p.programmable.length > 0 && ['programmable', 'What is programmable'],
  openProjects.length > 0 && ['projects', 'Third-party open projects'],
  p.traps.length > 0 && ['traps', 'Traps'],
  ['open', 'Open questions'],
].filter(Boolean);

function Conf(level) {
  return { cls: `conf conf-${level}`, label: confidence[level].label, note: confidence[level].note };
}

// Inline formatting for strings out of platforms.json: `code`, **bold** and
// *italic*. Code spans are lifted out first, so an asterisk sitting *inside*
// one — the dMix key wildcard is literally `**`, and enum names like `DEV_*`
// end in one — can never be read as emphasis. Bold runs before italic so the
// two-asterisk form is consumed whole and never seen as a nested single pair.
function fmt(s) {
  const spans = [];
  let out = s.replace(/`([^`]+)`/g, (_m, c) => `\u0000${spans.push(c) - 1}\u0000`);
  out = out.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  out = out.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
  // [text](/internal/path) — deliberately SITE-RELATIVE only. Entries cross-reference
  // each other (the DM3's traps point at the DM7 that corrected them), which is worth
  // having; letting a data file emit arbitrary hrefs is not, and an off-site citation
  // belongs in `artifacts`, where it is visible as a source rather than buried in prose.
  out = out.replace(/\[([^\]]+)\]\((\/[^)\s]*)\)/g, '<a href="$2">$1</a>');
  return out.replace(/\u0000(\d+)\u0000/g, (_m, i) => `<code>${spans[i]}</code>`);
}

const site = Astro.site.href.replace(/\/$/, '');
const pageUrl = `${site}/platforms/${p.id}/`;

// Related entries: same class first, then the rest of the same manufacturer. This is
// the site's only internal link graph beyond the index — without it every detail page
// is a leaf, which is bad for a reader comparing two platforms and worse for a crawler
// trying to work out that these pages belong together.
// Class and manufacturer alone leave the sole member of a class with no links at all
// — which is the page that needs them most, since nothing else on the site points at
// it either. Shared tags are the fallback: they are how "both of these are Zynq
// bare-metal designs" gets expressed across two unrelated classes.
const others = data.platforms.filter((o) => o.id !== p.id);
const shareTag = (o) => o.tags.filter((t) => p.tags.includes(t)).length;
// Last resort, for the sole member of a class that also shares no tags: everything in
// the same strand. Weaker than the rungs above it, but a page with no way out is worse.
const sameStrand = (o) => strandOf(o.class) === strandOf(p.class);

const related = [
  ...others.filter((o) => o.class === p.class),
  ...others.filter((o) => o.class !== p.class && o.manufacturer === p.manufacturer),
  ...others.filter((o) => shareTag(o) > 0).sort((a, b) => shareTag(b) - shareTag(a)),
  ...others.filter(sameStrand),
]
  .filter((o, i, arr) => arr.findIndex((x) => x.id === o.id) === i)
  .slice(0, 6);

// TechArticle rather than Article: these are technical documentation about a
// named product. `about` carries the product identity so the page can be
// matched to the device it describes, and isBasedOn records that the findings
// derive from firmware artifacts rather than from testing hardware.
const schema = [
  {
    '@type': 'TechArticle',
    '@id': `${pageUrl}#article`,
    headline: `${p.manufacturer} ${p.model} — hardware and software architecture`,
    description: p.summary,
    url: pageUrl,
    inLanguage: 'en-GB',
    isAccessibleForFree: true,
    // Both dates come from the entry's own `updated` field rather than from the build
    // clock: rebuilding the site does not modify an entry, and claiming it did is the
    // cheap freshness lie this site should be the last place to tell.
    datePublished: p.updated,
    dateModified: p.updated,
    publisher: { '@id': `${site}/#organization` },
    author: { '@id': `${site}/#organization` },
    isPartOf: { '@id': `${site}/#website` },
    // Ties every detail page back to the catalogue, so a consumer that lands here
    // can find the other 21 and the JSON without crawling.
    isPartOfDataset: { '@id': `${site}/platforms/#dataset` },
    keywords: p.tags,
    about: {
      '@type': 'Product',
      name: `${p.manufacturer} ${p.model}`,
      category: p.class,
      ...(p.manufacturer !== 'Stoatworks Labs' && {
        brand: { '@type': 'Brand', name: p.manufacturer },
      }),
    },
    ...(p.artifacts.length > 0 && {
      isBasedOn: p.artifacts.map((a) => a.replace(/[`*]/g, '')),
    }),
    articleSection: 'Reverse engineering',
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumbs`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Aux-opsy', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Platforms', item: `${site}/platforms/` },
      { '@type': 'ListItem', position: 3, name: `${p.manufacturer} ${p.model}` },
    ],
  },
];
---

<Base
  title={`${p.manufacturer} ${p.model} — Aux-opsy`}
  description={p.summary}
  section="platforms"
  schema={schema}
  updated={p.updated}
>
  <section class="band">
    <div class="wrap">
      <p class="eyebrow"><a href="/platforms/">Platform index</a> / {p.class}</p>
      <h1>{p.manufacturer} {p.model}</h1>
      <p class="lede">{p.summary}</p>
      <div class="card-meta" style="margin-top:1.25rem">
        <span class={`status status-${p.status}`} title={statusMeta?.note}>{statusMeta?.label}</span>
        {p.introduced && <span class="tag">Introduced {p.introduced}</span>}
        {p.family !== '—' && <span class="tag">{p.family}</span>}
        {p.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <p class="entry-meta">
        {/* The hardware line is stated up front rather than buried in the method
            section, because it is the single fact that most changes what the rest
            of the page is worth. */}
        {p.hardwareBasis
          ? <><strong>Hardware in our hands:</strong> {p.hardwareBasis}</>
          : <><strong>Hardware in our hands:</strong> none — every finding below came out of a file.</>}
        {p.updated && <> · Last updated <time datetime={p.updated}>{p.updated}</time></>}
      </p>
    </div>
  </section>

  <div class="wrap" style="padding-top:2.5rem">
    <div class="detail-grid">
      <nav class="toc" aria-label="On this page">
        <p class="eyebrow" style="margin-bottom:.25rem">On this page</p>
        <ul>
          {sections.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
          {related.length > 0 && <li><a href="#related">Related entries</a></li>}
        </ul>
      </nav>

      <div>
        <section id="summary">
          <div class="note">
            <p style="margin:0"><strong>The load-bearing finding.</strong> <span set:html={fmt(p.headline)} /></p>
          </div>
          <p class="prose"><strong>Verdict.</strong> <span set:html={fmt(p.verdict)} /></p>
        </section>

        {hasFindings && (
          <section id="method">
            <h2>Method</h2>
            <p class="prose" set:html={fmt(p.method)} />
            {p.artifacts.length > 0 && (
              <>
                <h3>Artifacts examined</h3>
                <ul class="prose">
                  {p.artifacts.map((a) => <li set:html={fmt(a)} />)}
                </ul>
              </>
            )}
            <p class="prose" style="color:var(--ink-2);font-size:.93rem">
              No manufacturer firmware, binaries or documentation are redistributed here.
              Artifacts are referenced by name and version only. See the{' '}
              <a href="/method/">method and legal statement</a> for the basis on which this
              analysis was performed and the boundaries it observes.
            </p>
          </section>
        )}

        {p.hardware.length > 0 && (
          <section id="hardware">
            <h2>Hardware architecture</h2>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr><th scope="col">Item</th><th scope="col">Finding</th><th scope="col">Confidence</th></tr>
                </thead>
                <tbody>
                  {p.hardware.map((h) => (
                    <tr>
                      <td class="k">{h.label}</td>
                      <td set:html={fmt(h.value)} />
                      <td><span class={Conf(h.confidence).cls} title={Conf(h.confidence).note}>{Conf(h.confidence).label}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {p.software.length > 0 && (
          <section id="software">
            <h2>Software architecture</h2>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr><th scope="col">Item</th><th scope="col">Finding</th><th scope="col">Confidence</th></tr>
                </thead>
                <tbody>
                  {p.software.map((s) => (
                    <tr>
                      <td class="k">{s.label}</td>
                      <td set:html={fmt(s.value)} />
                      <td><span class={Conf(s.confidence).cls} title={Conf(s.confidence).note}>{Conf(s.confidence).label}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        {p.security.length > 0 && (
          <section id="security">
            <h2>Update path &amp; security model</h2>
            <div class="table-scroll">
              <table>
                <thead>
                  <tr><th scope="col">Item</th><th scope="col">Finding</th><th scope="col">Confidence</th></tr>
                </thead>
                <tbody>
                  {p.security.map((s) => (
                    <tr>
                      <td class="k">{s.label}</td>
                      <td set:html={fmt(s.value)} />
                      <td><span class={Conf(s.confidence).cls} title={Conf(s.confidence).note}>{Conf(s.confidence).label}</span></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="prose" style="color:var(--ink-2);font-size:.93rem">
              These rows describe how a platform validates a firmware image, because that is
              a structural fact about its architecture. They are not a vulnerability
              disclosure and no exploit, bypass or circumvention technique is published here.
              Licensing and entitlement mechanisms are out of scope throughout — see
              <a href="/method/#boundaries">scope boundaries</a>.
            </p>
          </section>
        )}

        {p.programmable.length > 0 && (
          <section id="programmable">
            <h2>What is programmable</h2>
            <ol class="pill-list">
              {p.programmable.map((x) => (
                <li>
                  <span class="n">{x.rank}</span><strong set:html={fmt(x.item)} />
                  <p set:html={fmt(x.note)} />
                </li>
              ))}
            </ol>
          </section>
        )}

        {openProjects.length > 0 && (
          <section id="projects">
            <h2>Third-party open projects</h2>
            <p class="prose" style="color:var(--ink-2)">
              Independent open-source work on this platform, recorded because it is prior art
              and because in places it confirms or corrects findings above. These are other
              people's projects: the descriptions are ours, the work is theirs, and nothing
              from them is reproduced here.
            </p>
            {openProjects.map((op) => (
              <div class="proj">
                <h3>
                  <a href={op.url} rel="noopener">{op.name}</a>
                </h3>
                <div class="card-meta">
                  <span class="tag">{op.licence}</span>
                  <span class="tag">{op.activity}</span>
                  <span class={Conf('public').cls} title={Conf('public').note}>{Conf('public').label}</span>
                </div>
                <p class="prose" set:html={fmt(op.what)} />
                <ul class="prose">
                  {op.points.map((pt) => <li set:html={fmt(pt)} />)}
                </ul>
              </div>
            ))}
            <p class="prose" style="color:var(--ink-2);font-size:.93rem">
              Licence note: these projects are GPL-3.0. Facts about them — part numbers,
              what boots, what does not — are not copyrightable and are recorded freely.
              Their source is not a source for our own differently-licensed work, and no code
              from them is used in it.
            </p>
          </section>
        )}

        {p.traps.length > 0 && (
          <section id="traps">
            <h2>Traps</h2>
            <p class="prose" style="color:var(--ink-2)">
              Mistakes this analysis actually made, or came close to making. They are recorded
              because each one produces a plausible-looking wrong answer rather than an obvious
              failure.
            </p>
            <ul class="prose">
              {p.traps.map((t) => <li set:html={fmt(t)} />)}
            </ul>
          </section>
        )}

        <section id="open">
          <h2>Open questions</h2>
          <ul class="prose">
            {p.openQuestions.map((o) => <li set:html={fmt(o)} />)}
          </ul>
          <div class="note warn">
            <p style="margin:0">
              <strong>Status of this entry.</strong> {statusMeta?.note}
              {' '}{p.hardwareBasis
                ? <>Rows labelled <span class="conf conf-measured">Measured</span> were read off
                  a running unit; everything else on this page is derived from files and has
                  not been checked against hardware.</>
                : <>Nothing on this page has been verified against physical hardware — no unit
                  of this platform has been opened, connected to or modified.</>}
            </p>
          </div>
        </section>

        {related.length > 0 && (
          <section id="related">
            <h2>Related entries</h2>
            <ul class="prose related">
              {related.map((o) => (
                <li>
                  <a href={`/platforms/${o.id}/`}>{o.manufacturer} {o.model}</a>
                  {' '}— <span style="color:var(--ink-2)">{o.class}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <p style="margin-top:3rem"><a href="/platforms/">← Back to the platform index</a></p>
      </div>
    </div>
  </div>
</Base>
